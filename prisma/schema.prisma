generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors the Supabase Auth user (auth.users). id == supabase auth user id.
/// We keep a local copy so we can join against Documents/Chat/etc with Prisma.
model Profile {
  id        String   @id
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  documents            Document[]
  chatSessions         ChatSession[]
  chatMessages         ChatMessage[]
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  aiOutputs            AIOutput[]
  favorites            Favorite[]
  savedSearches        SavedSearch[]
  shareLinks           ShareLink[]
  mediaAssets          MediaAsset[]
  imageTranslations     ImageTranslation[]
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         Profile              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  documents     Document[]
  conversations ChatSession[]
  aiOutputs     AIOutput[]
  collections   Collection[]
  tags          Tag[]
  favorites     Favorite[]
  shareLinks    ShareLink[]
  mediaAssets   MediaAsset[]
  imageTranslations ImageTranslation[]
  preference    WorkspacePreference?
  savedSearches SavedSearch[]

  @@index([ownerId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Document {
  id              String   @id @default(uuid())
  originalName    String
  fileName        String
  mimeType        String
  size            Int
  /// Path/key of the object inside Supabase Storage (bucket + key), not a local disk path.
  storagePath     String
  storageBucket   String   @default("documents")
  status          String   @default("UPLOADED")
  extractedText   String?
  metadata        Json?
  checksum        String?  @db.VarChar(64)
  processingError String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks          DocumentChunk[]
  summaries       DocumentSummary[]
  diagrams        DocumentDiagram[]
  sessions        ChatSession[]
  aiOutputs       AIOutputSource[]
  collectionItems CollectionItem[]
  tagAssignments  TagAssignment[]
  favorites       Favorite[]
  shareLinks      ShareLink[]

  userId      String
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  content    String
  chunkIndex Int
  documentId String
  createdAt  DateTime @default(now())

  /// pgvector column - not directly readable/writable through the Prisma client.
  /// Written/read via $executeRaw / $queryRaw in EmbeddingsService & RagService.
  embedding Unsupported("vector(1536)")?

  /// Generated PostgreSQL full-text search vector. Read by TextSearchRetriever.
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model DocumentSummary {
  id          String   @id @default(uuid())
  documentId  String
  content     String
  llmProvider String
  llmModel    String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentDiagram {
  id          String   @id @default(uuid())
  documentId  String
  diagramType String   @default("flowchart")
  mermaidCode String
  llmProvider String
  llmModel    String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ChatSession {
  id             String   @id @default(uuid())
  title          String   @default("New chat")
  userId         String
  documentId     String?
  workspaceId    String?
  provider       String?
  model          String?
  temperature    Float    @default(0.7)
  topP           Float    @default(1)
  maxTokens      Int      @default(1024)
  metadata       Json?
  streamStatus   String   @default("IDLE")
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  usage     ModelUsage[]
  aiOutputs AIOutput[]

  @@index([userId])
  @@index([documentId])
  @@index([workspaceId, lastActivityAt])
}

model ChatMessage {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String
  role         String
  content      String
  llmProvider  String?
  llmModel     String?
  finishReason String?
  metadata     Json?
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ModelUsage {
  id               String   @id @default(uuid())
  conversationId   String?
  userId           String
  workspaceId      String?
  provider         String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float?
  latencyMs        Int
  success          Boolean
  errorCode        String?
  requestId        String?
  streamed         Boolean  @default(false)
  createdAt        DateTime @default(now())

  conversation ChatSession? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([provider, model, createdAt])
}

enum AIOutputType {
  SUMMARY
  MIND_MAP
  TRANSLATION
  REPORT
  KEY_POINTS
  GLOSSARY
  FLASHCARDS
  QUIZ
  STUDY_GUIDE
  ANALYTICS_REPORT
  CHART
}

enum MediaAssetType {
  IMAGE
  VIDEO
  AUDIO
}

model MediaAsset {
  id            String         @id @default(uuid())
  type          MediaAssetType
  status        String         @default("PROCESSING")
  prompt        String         @db.Text
  provider      String
  model         String?
  providerJobId String?
  mimeType      String?
  storagePath   String?
  sourceUrl     String?
  error         String?
  metadata      Json?
  userId        String
  workspaceId   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model ImageTranslation {
  id                  String   @id @default(uuid())
  originalName        String
  mimeType            String
  size                Int
  status              String   @default("PROCESSING")
  sourceLanguage      String
  targetLanguage      String
  extractedText       String   @db.Text
  translatedText      String   @db.Text
  ocrBoxes            Json
  originalStoragePath  String
  translatedStoragePath String?
  translatedMimeType  String?
  outputId            String?  @unique
  error               String?
  userId              String
  workspaceId         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model AIOutput {
  id             String       @id @default(uuid())
  type           AIOutputType
  title          String
  content        Json
  metadata       Json?
  provider       String
  model          String
  userId         String
  workspaceId    String
  conversationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user            Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    ChatSession      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources         AIOutputSource[]
  collectionItems CollectionItem[]
  tagAssignments  TagAssignment[]
  favorites       Favorite[]
  shareLinks      ShareLink[]
  versions        OutputVersion[]

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@index([type, createdAt])
}

model AIOutputSource {
  outputId String
  sourceId String

  output AIOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  source Document @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([outputId, sourceId])
  @@index([sourceId])
}

/// Catalog of LLMs the AI gateway can route to. Seeded on boot; editable via API.
model LlmConfig {
  id           String   @id @default(uuid())
  provider     String   @unique
  displayName  String
  model        String
  isActive     Boolean  @default(true)
  isConfigured Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Collection {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  parentId    String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Collection?      @relation("CollectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Collection[]     @relation("CollectionTree")
  items     CollectionItem[]

  @@index([workspaceId, parentId, position])
  @@index([workspaceId, deletedAt])
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  sourceId     String?
  outputId     String?
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source     Document?  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  output     AIOutput?  @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@unique([collectionId, sourceId])
  @@unique([collectionId, outputId])
  @@index([sourceId])
  @@index([outputId])
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  color       String?
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments   TagAssignment[]
  savedSearches SavedSearch[]

  @@unique([workspaceId, name])
  @@index([workspaceId, deletedAt])
}

model SavedSearch {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  tagId       String?
  name        String
  query       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tag       Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId, name])
  @@index([userId, workspaceId, updatedAt])
}

model TagAssignment {
  id        String   @id @default(uuid())
  tagId     String
  sourceId  String?
  outputId  String?
  createdAt DateTime @default(now())

  tag    Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  source Document? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  output AIOutput? @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@unique([tagId, sourceId])
  @@unique([tagId, outputId])
  @@index([sourceId])
  @@index([outputId])
}

model Favorite {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  sourceId    String?
  outputId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    Document? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  output    AIOutput? @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@unique([userId, outputId])
  @@index([workspaceId, userId])
}

model ShareLink {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  workspaceId String
  userId      String
  sourceId    String?
  outputId    String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    Document? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  output    AIOutput? @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model OutputVersion {
  id        String   @id @default(uuid())
  outputId  String
  event     String
  title     String
  content   Json
  metadata  Json?
  provider  String
  model     String
  createdAt DateTime @default(now())

  output AIOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@index([outputId, createdAt])
}

model WorkspacePreference {
  id                  String   @id @default(uuid())
  workspaceId         String   @unique
  defaultProvider     String   @default("openai")
  defaultModel        String   @default("gpt-4o-mini")
  language            String   @default("en")
  theme               String   @default("system")
  defaultExportFormat String   @default("markdown")
  streaming           Boolean  @default(true)
  autosave            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  workspaceId String?
  action      String
  ipAddress   String?
  userAgent   String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
