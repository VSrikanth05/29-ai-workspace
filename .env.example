IMAGE_TRANSLATION_OCR_URL=
IMAGE_TRANSLATION_OCR_FALLBACK_URL=
IMAGE_TRANSLATION_LANGUAGE_URL=
IMAGE_TRANSLATION_NLLB_URL=
IMAGE_TRANSLATION_RENDER_URL=
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
CACHE_PREFIX=aida
CACHE_TTL_SECONDS=60
INGESTION_ASYNC_ENABLED=true
INGESTION_WORKER_CONCURRENCY=2
INGESTION_JOB_ATTEMPTS=3
WORKER_SHUTDOWN_TIMEOUT_MS=30000
CORS_ORIGINS=https://documents.example.com
TRUST_PROXY_HOPS=1
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
AI_MODEL_PRICING_JSON={}
REQUEST_BODY_LIMIT=1mb
SWAGGER_ENABLED=false
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
RAG_VECTOR_CANDIDATES=15
RAG_TEXT_CANDIDATES=15
RAG_VECTOR_WEIGHT=0.65
RAG_TEXT_WEIGHT=0.35
RAG_MIN_SCORE=0
RAG_RERANK_ENABLED=true
FRONTEND_PORT=8080
BACKEND_PORT=5000
BACKEND_INTERNAL_URL=http://backend:5000
NEXT_PUBLIC_API_URL=/api
