# Email Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="29 AI Workspace <onboarding@resend.dev>"

# Payments & Subscriptions (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Free Tier LLM Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=
