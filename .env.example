OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_AUDIO_MODEL=gpt-4o-mini-tts
